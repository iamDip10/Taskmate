# The 4-digit (or longer) shared access code that gets someone into TaskMate.
# Never exposed to the browser — it's only ever checked on the server.
APP_ACCESS_CODE=2703

# Secret used to sign the session cookie. Use a long random string in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-long-random-string

# PostgreSQL connection string. Works great with Vercel Postgres, Neon, or Supabase
# free tiers. Must be a valid Postgres URL.
DATABASE_URL=postgres://9999d2a6e59349f04e19c5b80c241da3f0cfff69dd3cce57ca7a0c53556cb0a6:sk_erXSvvVp31Xi_VKTa2ZQQ@pooled.db.prisma.io:5432/postgres?sslmode=require
